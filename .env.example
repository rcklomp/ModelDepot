# Copy to .env (docker compose reads it) and adjust. Everything here is optional except DATA_DIR on a NAS.

# Where the store lives: the models and datasets, the download queue, your settings and the admin token.
# On a Synology: a shared-folder path such as /volume1/docker/llm-repo (the folder must exist).
DATA_DIR=./data

# The port the GUI and the Hugging Face-compatible API share.
PORT=8000

# Local time for the GUI's download window.
TZ=Europe/Amsterdam

# Clients must send this token (client side: HF_TOKEN=<this>) to download. Empty: anyone on the LAN can download (the default).
MIRROR_AUTH_TOKEN=

# The token the GUI asks for before it changes anything (download, delete, settings). Empty: the server makes one on first start
# and keeps it in DATA_DIR/config/admin-token (it is also written to the container log once).
MIRROR_ADMIN_TOKEN=

# Your Hugging Face token, for gated models. Can also be entered in the GUI (Settings).
MIRROR_HF_TOKEN=
