# Copy to .env and adjust. All values have sensible defaults.

# Root directory of the mirror store. This is the only path that matters.
# On a Synology: /volume1/llm-mirror
# On an external SSD: /Volumes/MySSD/llm-mirror
MIRROR_ROOT=./data/mirror-root

# Host + port the HTTP shim listens on (Caddy proxies to this).
MIRROR_HOST=0.0.0.0
MIRROR_PORT=8000

# Base URL the mirror advertises to clients (used in metadata responses).
# When behind Caddy with TLS, set this to https://mirror.lan
MIRROR_BASE_URL=http://localhost:8000

# Public base URL clients use for HF_ENDPOINT. Usually same as MIRROR_BASE_URL.
# Clients set:  HF_ENDPOINT=<this value>  HF_HUB_DISABLE_XET=1
MIRROR_PUBLIC_URL=http://localhost:8000

# If set to 1, the shim rejects all write/ingest HTTP routes (ingest via CLI only).
MIRROR_READ_ONLY=0

# Optional bearer token clients must send. Leave empty for no auth (LAN-trusted).
MIRROR_AUTH_TOKEN=

# Index backend: "sqlite" (default) or "none" (lowest resource, e.g. DS713+).
MIRROR_INDEX_BACKEND=sqlite
