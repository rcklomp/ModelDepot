[Unit]
Description=llama.cpp Vulkan server (multi-GPU, all 3x 7900 XTX)
After=network.target

[Service]
Type=simple
User=ronald
Group=ronald
SupplementaryGroups=render video
EnvironmentFile=/etc/default/llama-server
WorkingDirectory=/home/ronald/src/llama.cpp
ExecStart=/home/ronald/bin/llama-server.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
